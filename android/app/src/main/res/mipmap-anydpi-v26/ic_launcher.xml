<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon: the launcher supplies the tile shape, so only the page
     artwork is drawn here, inside the 66 dp safe zone. Both layers are
     generated from assets/brand/icon_master.png by
     scripts/build_launcher_icons.py. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
